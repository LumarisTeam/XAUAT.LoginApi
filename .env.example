ASPNETCORE_ENVIRONMENT=Production

# Redis 连接字符串；留空表示不启用 Redis。
# 两种失败语义刻意区分开：
#   留空        -> 降级为"无缓存、无限流"的全量登录（与 Flask 一致）
#   填了却连不上 -> 启动直接失败（abortConnect 默认 true），不会静默降级
#
# 重要：本服务**与 Flask 共用同一批 Redis 键**（login-cookies-* / sso-cookies-* /
# security:* / current_semester），这是有意为之——灰度期间两边可以并行跑，
# 缓存不冷、封禁状态延续。因此这里应当填 Flask 现网用的那个实例。
# 键名硬编码在 LoginCacheKeys，不通过环境变量配置。
REDIS=

# /Logs 的访问令牌。留空 = 该接口完全开放（Flask 的既有行为，便于本地开发）。
# 设置后需带 X-Log-Token 或 Authorization: Bearer。
LOG_VIEW_TOKEN=

# /Logs 的额外跨域来源（逗号分隔）。
# 内置白名单为 localhost / 127.0.0.1 / *.luckyfishes.site / *.xauat.site。
# 管理端 lumaris_admin 部署在 Vercel 域名上，必须在这里显式放行，
# 否则浏览器请求会被 CORS 拦掉（服务端不会有任何异常日志）。
CORS_ALLOWED_ORIGINS=

# 日志目录（按天轮转 log.log，保留 31 天；重启时回填到内存缓冲供 /Logs 查询）
LOG_DIR=logs

TEST_ACCOUNT_ENABLED=false
TEST_ACCOUNT_USERNAME=frontend-test
TEST_ACCOUNT_PASSWORD=frontend-test-password
TEST_ACCOUNT_STUDENT_ID=20239999
TEST_ACCOUNT_COOKIE_MARKER=frontend-test-marker
TEST_ACCOUNT_FIXTURE_PATH=TestFixtures
